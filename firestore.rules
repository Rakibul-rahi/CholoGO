rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function isOwner(uid) {
      return signedIn() && myUid() == uid;
    }

    function myUserDoc() {
      return get(/databases/$(database)/documents/users/$(myUid()));
    }

    function myRole() {
      return myUserDoc().data.role;
    }

    function isPassenger() {
      return signedIn() && myRole() == "passenger";
    }

    function isRider() {
      return signedIn() && myRole() == "rider";
    }

    match /users/{userId} {

      // The owner may edit their own profile fields, but never the fields
      // that are supposed to be earned/assigned by others - role (which
      // every isPassenger()/isRider() check in this file trusts blindly),
      // and the rating/report counters below.
      //
      // "xp" used to be on this list, which meant any signed-in user could
      // set their own XP to any number they liked straight from a
      // Firestore client - no ride, no app, nothing to stop them. It is
      // gone for good, and nothing may write it again: XP is now the sum
      // of a user's rows in xp_events, an append-only ledger where every
      // row has to justify itself. See the notes there for why a counter
      // cannot be secured with rules at all.
      //
      // The field may still exist on older user documents. It is dead
      // data - never read, never written.
      function ownerProfileEdit() {
        return isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              "name", "phone", "email", "university", "studentId", "homeLocation",
              "fcmTokens",
              // A rider may switch between a bike and a car, and correct
              // their car's details, from their own profile. role stays
              // excluded above - swapping vehicles is not swapping roles.
              "vehicleType", "vehicleModel", "vehicleNumber", "vehicleColor"
            ]);
      }

      // Backs RideNowFeedbackRepository.submitRideRating(): a rating from
      // someone else bumps ratingCount by exactly one and moves the average
      // by an amount consistent with a single new 1-5 star vote (a small
      // epsilon absorbs floating point round-trip noise between the
      // client's math and this recomputation - it does not widen how much
      // a single rating can move the average). Nobody may rate themselves.
      function isValidRatingBump() {
        let oldCount = resource.data.get('ratingCount', 0);
        let oldAvg = resource.data.get('ratingAverage', 0);
        let newCount = request.resource.data.get('ratingCount', 0);
        let newAvg = request.resource.data.get('ratingAverage', 0);
        let oldTotal = oldAvg * oldCount;
        let newTotal = newAvg * newCount;

        return signedIn()
          && userId != myUid()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["ratingAverage", "ratingCount"])
          && newCount == oldCount + 1
          && newTotal >= oldTotal + 1 - 0.05
          && newTotal <= oldTotal + 5 + 0.05;
      }

      // Backs RideNowFeedbackRepository.submitRideReport(): a report from
      // someone else bumps reportCount by exactly one. Nobody may report
      // themselves.
      function isValidReportBump() {
        let oldReportCount = resource.data.get('reportCount', 0);
        let newReportCount = request.resource.data.get('reportCount', 0);

        return signedIn()
          && userId != myUid()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["reportCount"])
          && newReportCount == oldReportCount + 1;
      }

      allow create: if isOwner(userId);

      allow read: if signedIn();

      allow update: if ownerProfileEdit()
        || isValidRatingBump()
        || isValidReportBump();

      allow delete: if isOwner(userId);
    }

    // ---------- Tomorrow flow: passenger-side pre-scheduled requests ----------
    match /ride_requests/{requestId} {

      // A passenger may only edit their own request, and only while it's
      // still "pending" - once a rider has accepted it, the passenger can
      // no longer touch it via a normal update (e.g. can't forge
      // status/matchedRiderId/matchedRiderPhone on their own document).
      function passengerOwnRequestEdit() {
        return isPassenger()
          && resource.data.userId == myUid()
          && resource.data.status == "pending"
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.status == "pending";
      }

      // upsertPassengerRequest() also resubmits a request the passenger
      // already cancelled, or that a rider backed out of after accepting -
      // otherwise a cancelled leg could never return to "pending", so no
      // other rider could ever see or match it again.
      function passengerResubmitCancelled() {
        return isPassenger()
          && resource.data.userId == myUid()
          && resource.data.status == "cancelled"
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.status == "pending";
      }

      // A rider may add themselves to rejectedByRiderIds (decline) without
      // touching status or any matched* field.
      function riderDeclineOnly() {
        return isRider()
          && request.resource.data.rejectedByRiderIds.hasAll(resource.data.rejectedByRiderIds)
          && request.resource.data.status == resource.data.status
          && request.resource.data.matchedRiderId == resource.data.matchedRiderId;
      }

      // A rider may accept a still-pending request, but only by matching
      // themselves - they cannot set matchedRiderId to any other uid, and
      // this is the only path allowed to move status out of "pending".
      function riderAccept() {
        return isRider()
          && resource.data.status == "pending"
          && request.resource.data.status == "accepted"
          && request.resource.data.matchedRiderId == myUid();
      }

      // A rider may cancel a request already matched to them. Both
      // documents involved (this request, and their own ride) are within
      // the rider's ownership, so this can be finalized directly here -
      // unlike a passenger-initiated cancellation, which needs a Cloud
      // Function since it touches the rider's ride document.
      function riderCancelOwnAcceptedRequest() {
        return isRider()
          && resource.data.status == "accepted"
          && resource.data.matchedRiderId == myUid()
          && request.resource.data.status == "cancelled"
          && request.resource.data.matchedRiderId == resource.data.matchedRiderId;
      }

      // ---------- Trip lifecycle (mirrors ride_now_requests) ----------

      // riderStartTrip(): only the matched rider.
      function riderStartTrip() {
        return isRider()
          && resource.data.status == "accepted"
          && resource.data.matchedRiderId == myUid()
          && request.resource.data.status == "start_pending_confirmation"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "rideStartedByRider", "rideConfirmedByPassenger", "startedAt"]);
      }

      // passengerConfirmTripStarted(): only the owning passenger.
      function passengerConfirmStart() {
        return isPassenger()
          && resource.data.userId == myUid()
          && resource.data.status == "start_pending_confirmation"
          && request.resource.data.status == "ongoing"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "rideConfirmedByPassenger", "startedAt"]);
      }

      // passengerRejectTripStarted(): only the owning passenger.
      function passengerRejectStart() {
        return isPassenger()
          && resource.data.userId == myUid()
          && resource.data.status == "start_pending_confirmation"
          && request.resource.data.status == "accepted"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "rideStartedByRider", "rideConfirmedByPassenger", "startedAt"]);
      }

      // riderRequestTripCompletion(): only the matched rider.
      function riderRequestCompletion() {
        return isRider()
          && resource.data.status == "ongoing"
          && resource.data.matchedRiderId == myUid()
          && request.resource.data.status == "end_pending_confirmation"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "rideEndedByRider", "rideCompletedByPassenger", "completedAt"]);
      }

      // passengerConfirmTripCompleted(): only the owning passenger.
      function passengerConfirmCompletion() {
        return isPassenger()
          && resource.data.userId == myUid()
          && resource.data.status == "end_pending_confirmation"
          && request.resource.data.status == "completed"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "rideCompletedByPassenger", "completedAt"]);
      }

      // ---------- Missed-trip reconciliation ----------
      // A leg whose departure passed with the lifecycle never finished is
      // reconstructed after the fact: each side answers "did this ride
      // happen?" exactly once, and the SECOND answer also closes the leg.
      //
      // The closing status is not the answerer's to choose. These rules
      // re-derive it from both answers, the same way
      // RideRequest.resolvedStatusAfter() does client-side, so no client
      // can talk its way to a "completed" trip the other side never
      // vouched for:
      //   first answer in  -> status must not move at all
      //   answers agree    -> "completed" (yes) / "not_completed" (no)
      //   answers disagree -> "unverified", which counts for neither side

      function retroUnfinished() {
        return resource.data.status in [
          "accepted", "start_pending_confirmation", "ongoing", "end_pending_confirmation"
        ];
      }

      // [ownAnswer] is this side's new answer, [otherAnswer] the answer
      // already stored for the other side ("" while they haven't answered).
      function retroStatusIsDerived(ownAnswer, otherAnswer) {
        let newStatus = request.resource.data.status;

        return (otherAnswer == "" && newStatus == resource.data.status)
          || (otherAnswer == ownAnswer && ownAnswer == "yes" && newStatus == "completed")
          || (otherAnswer == ownAnswer && ownAnswer == "no" && newStatus == "not_completed")
          || (otherAnswer != "" && otherAnswer != ownAnswer && newStatus == "unverified");
      }

      // submitMissedRideAnswer(), passenger side. One-shot: the old answer
      // must be empty, and the rider's answer may not be touched.
      function passengerRetroAnswer() {
        let ownAnswer = request.resource.data.passengerHappenedAnswer;

        return isPassenger()
          && resource.data.userId == myUid()
          && retroUnfinished()
          && resource.data.get('passengerHappenedAnswer', '') == ''
          && ownAnswer in ["yes", "no"]
          && request.resource.data.get('riderHappenedAnswer', '') == resource.data.get('riderHappenedAnswer', '')
          && retroStatusIsDerived(ownAnswer, resource.data.get('riderHappenedAnswer', ''))
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "passengerHappenedAnswer", "passengerAnsweredAt", "completedAt"]);
      }

      // submitMissedRideAnswer(), rider side.
      function riderRetroAnswer() {
        let ownAnswer = request.resource.data.riderHappenedAnswer;

        return isRider()
          && resource.data.matchedRiderId == myUid()
          && retroUnfinished()
          && resource.data.get('riderHappenedAnswer', '') == ''
          && ownAnswer in ["yes", "no"]
          && request.resource.data.get('passengerHappenedAnswer', '') == resource.data.get('passengerHappenedAnswer', '')
          && retroStatusIsDerived(ownAnswer, resource.data.get('passengerHappenedAnswer', ''))
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "riderHappenedAnswer", "riderAnsweredAt", "completedAt"]);
      }

      // (There is deliberately no XP-claim branch here. A reconciled leg
      // pays out through the xp_events ledger like any other completed
      // trip - the ledger's derived document IDs already give one-shot
      // semantics, and better ones, since they also stop the normal and
      // reconstructed completion paths both paying for the same leg.)

      // TomorrowFeedbackRepository.submitRideRating(): only the owning
      // passenger, one star rating, one time.
      function passengerSubmitRating() {
        return isPassenger()
          && resource.data.userId == myUid()
          && resource.data.riderRated == false
          && resource.data.issueReported == false
          && request.resource.data.riderRated == true
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["riderRated", "rating", "ratedAt"]);
      }

      // TomorrowFeedbackRepository.submitRideReport(): only the owning
      // passenger, one time.
      function passengerSubmitReport() {
        return isPassenger()
          && resource.data.userId == myUid()
          && resource.data.issueReported == false
          && resource.data.riderRated == false
          && request.resource.data.issueReported == true
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["issueReported", "reportReason", "reportDetails", "reportedAt"]);
      }

      allow create: if isPassenger()
        && request.resource.data.userId == myUid()
        && request.resource.data.status == "pending";

      allow read: if
        (isPassenger() && resource.data.userId == myUid())
        || isRider();

      // A passenger's own cancellation of an accepted request is now
      // handled entirely by the standalone REST server (via Admin SDK,
      // which bypasses these rules), not by a direct client write - so
      // there's deliberately no rule branch here permitting it. Keeping
      // rules minimal to what the client actually needs to do directly.

      allow update: if passengerOwnRequestEdit()
        || passengerResubmitCancelled()
        || riderDeclineOnly()
        || riderAccept()
        || riderCancelOwnAcceptedRequest()
        || riderStartTrip()
        || passengerConfirmStart()
        || passengerRejectStart()
        || riderRequestCompletion()
        || passengerConfirmCompletion()
        || passengerRetroAnswer()
        || riderRetroAnswer()
        || passengerSubmitRating()
        || passengerSubmitReport();

      // Deleting an already-accepted request would orphan the rider's seat
      // count with nothing to ever restore it. Block until a proper
      // cancellation flow (that also releases the matched ride's seat)
      // exists.
      allow delete: if isPassenger()
        && resource.data.userId == myUid()
        && resource.data.status == "pending";
    }

    // ---------- Tomorrow flow: rider-side pre-scheduled rides ----------
    match /rides/{rideId} {
      allow create: if isRider()
        && request.resource.data.riderId == myUid();

      // Signed-out browsing: anyone may read a still-open ("active")
      // scheduled ride so the app can show real listings before login.
      // Full/cancelled rides, and anything for a passenger's own matching
      // logic, still go through the isPassenger()/isRider() branches below.
      allow read: if
        (isRider() && resource.data.riderId == myUid())
        || isPassenger()
        || resource.data.status == "active";

      allow update: if isRider()
        && resource.data.riderId == myUid();

      // Same reasoning as ride_requests above: an already-matched ("full")
      // ride can't be deleted out from under an accepted passenger. A
      // still-"active" (unmatched) ride can be freely removed/edited.
      allow delete: if isRider()
        && resource.data.riderId == myUid()
        && resource.data.status == "active";
    }

    // ---------- Ride Now (instant matching) ----------
    match /live_rides/{rideId} {
      allow create: if isRider()
        && request.resource.data.riderId == myUid();

      // Signed-out browsing: anyone may read a currently live, open ride so
      // the app can show real listings before login.
      //
      // NOTE: Firestore strips the "is" prefix from Kotlin boolean field
      // names (LiveRide.isLiveNow / isAvailable are stored as "liveNow" /
      // "available" - see RideNowRequestRepository.acceptRideNowRequest for
      // the full explanation), so rules must reference "liveNow"/"available",
      // not the Kotlin property names.
      allow read: if
        (isRider() && resource.data.riderId == myUid())
        || isPassenger()
        || (resource.data.status == "active" && resource.data.liveNow == true);

      allow update: if
        (
          isRider()
          && resource.data.riderId == myUid()
        )
        ||
        (
          isPassenger()
          && request.resource.data.available == true
          && request.resource.data.currentRequestId == ""
        );

      allow delete: if isRider()
        && resource.data.riderId == myUid();
    }

    match /ride_now_requests/{requestId} {

      // Mirrors every write RideNowRequestRepository / RideNowFeedbackRepository
      // actually performs, one function per transition, each pinning exactly
      // which keys may move. Unlike the old blanket "isPassenger(own) ||
      // isRider()" rule, a rider can no longer touch a request they aren't
      // matched to, and neither side can smuggle unrelated field edits into
      // an accept/cancel/start/complete/report/rate call.

      function passengerCreate() {
        return isPassenger()
          && request.resource.data.passengerId == myUid()
          && request.resource.data.status == "searching"
          && request.resource.data.matchedRiderId == ""
          && request.resource.data.matchedRideId == ""
          && request.resource.data.riderRated == false
          && request.resource.data.issueReported == false;
      }

      // cancelRideNowRequest(): passenger backs out before any rider has
      // matched.
      function passengerCancelSearching() {
        return isPassenger()
          && resource.data.passengerId == myUid()
          && resource.data.status in ["searching", "notified"]
          && request.resource.data.status == "cancelled"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "cancelledAt"]);
      }

      // cancelAcceptedRideNowTrip(): passenger backs out of an already
      // matched trip.
      function passengerCancelAccepted() {
        return isPassenger()
          && resource.data.passengerId == myUid()
          && resource.data.status in
            ["accepted", "start_pending_confirmation", "ongoing", "end_pending_confirmation"]
          && request.resource.data.status == "cancelled"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "cancelledAt"]);
      }

      // expireRequestIfNeeded(): either side can flip a stale, still-unmatched
      // request to expired - a rider triggers it while browsing the matching
      // list, the passenger while watching their own request.
      function expireSearching() {
        return (isRider() || (isPassenger() && resource.data.passengerId == myUid()))
          && resource.data.status == "searching"
          && request.resource.data.status == "expired"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "expiredAt"]);
      }

      // acceptRideNowRequest(): a rider may match a still-searching request
      // only to themselves.
      function riderAccept() {
        return isRider()
          && resource.data.status == "searching"
          && request.resource.data.status == "accepted"
          && request.resource.data.matchedRiderId == myUid()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              "status", "matchedRideId", "matchedRiderId", "matchedRiderName",
              "matchedRiderPhone", "acceptedAt", "rideStartedByRider",
              "rideConfirmedByPassenger", "rideEndedByRider",
              "rideCompletedByPassenger", "startedAt", "completedAt",
              // Vehicle snapshot copied off the matched live ride, so the
              // passenger can see which bike/car is coming.
              "matchedVehicleType", "matchedVehicleModel",
              "matchedVehicleNumber", "matchedVehicleColor"
            ]);
      }

      // riderStartRideNowTrip(): only the matched rider.
      function riderStart() {
        return isRider()
          && resource.data.status == "accepted"
          && resource.data.matchedRiderId == myUid()
          && request.resource.data.status == "start_pending_confirmation"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "rideStartedByRider", "rideConfirmedByPassenger", "startedAt"]);
      }

      // passengerConfirmRideNowStarted(): only the owning passenger.
      function passengerConfirmStart() {
        return isPassenger()
          && resource.data.passengerId == myUid()
          && resource.data.status == "start_pending_confirmation"
          && request.resource.data.status == "ongoing"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "rideConfirmedByPassenger", "startedAt"]);
      }

      // passengerRejectRideNowStarted(): only the owning passenger.
      function passengerRejectStart() {
        return isPassenger()
          && resource.data.passengerId == myUid()
          && resource.data.status == "start_pending_confirmation"
          && request.resource.data.status == "accepted"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "rideStartedByRider", "rideConfirmedByPassenger", "startedAt"]);
      }

      // riderRequestRideNowCompletion(): only the matched rider.
      function riderRequestCompletion() {
        return isRider()
          && resource.data.status == "ongoing"
          && resource.data.matchedRiderId == myUid()
          && request.resource.data.status == "end_pending_confirmation"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "rideEndedByRider", "rideCompletedByPassenger", "completedAt"]);
      }

      // passengerConfirmRideNowCompleted(): only the owning passenger.
      function passengerConfirmCompletion() {
        return isPassenger()
          && resource.data.passengerId == myUid()
          && resource.data.status == "end_pending_confirmation"
          && request.resource.data.status == "completed"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "rideCompletedByPassenger", "completedAt"]);
      }

      // ---------- Rider abandonment escape hatches ----------
      // Nothing in the normal lifecycle lets a rider move a trip forward
      // once the passenger stops responding: start only accepts
      // "accepted", completion only accepts "ongoing", and the passenger
      // is the only one who can confirm either. These two transitions are
      // the rider's way out, and both take their own LiveRide offline in
      // the same transaction (covered by the live_rides owner rule).

      // riderCancelUnstartedTrip(): the passenger never got on.
      function riderCancelUnstarted() {
        return isRider()
          && resource.data.matchedRiderId == myUid()
          && resource.data.status in ["accepted", "start_pending_confirmation"]
          && request.resource.data.status == "cancelled"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "cancelledAt", "closedByRole", "closedAt"]);
      }

      // riderCloseUnconfirmedTrip(): the trip was really driven, but only
      // the rider ever said so. "unverified", never "completed" - one
      // side's word alone must not be able to mint a completed trip (and
      // with it a ride_history entry) for the other.
      function riderCloseUnconfirmed() {
        return isRider()
          && resource.data.matchedRiderId == myUid()
          && resource.data.status in ["ongoing", "end_pending_confirmation"]
          && request.resource.data.status == "unverified"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "closedByRole", "closedAt"]);
      }

      // passengerReportRideNowIssue(): only the owning passenger, and only
      // on a trip that isn't already finished.
      function passengerReportIssue() {
        return isPassenger()
          && resource.data.passengerId == myUid()
          && !(resource.data.status in ["completed", "cancelled", "expired", "issue_reported"])
          && request.resource.data.status == "issue_reported"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "issueReportedAt"]);
      }

      // submitRideRating(): only the owning passenger, one star rating,
      // one time.
      function passengerSubmitRating() {
        return isPassenger()
          && resource.data.passengerId == myUid()
          && resource.data.riderRated == false
          && resource.data.issueReported == false
          && request.resource.data.riderRated == true
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["riderRated", "rating", "ratedAt"]);
      }

      // submitRideReport(): only the owning passenger, one time.
      function passengerSubmitReport() {
        return isPassenger()
          && resource.data.passengerId == myUid()
          && resource.data.issueReported == false
          && resource.data.riderRated == false
          && request.resource.data.issueReported == true
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["issueReported", "reportReason", "reportDetails", "reportedAt"]);
      }

      allow create: if passengerCreate();

      allow read: if
        (isPassenger() && resource.data.passengerId == myUid())
        || isRider();

      allow update: if passengerCancelSearching()
        || passengerCancelAccepted()
        || riderCancelUnstarted()
        || riderCloseUnconfirmed()
        || expireSearching()
        || riderAccept()
        || riderStart()
        || passengerConfirmStart()
        || passengerRejectStart()
        || riderRequestCompletion()
        || passengerConfirmCompletion()
        || passengerReportIssue()
        || passengerSubmitRating()
        || passengerSubmitReport();

      allow delete: if isPassenger()
        && resource.data.passengerId == myUid()
        && resource.data.status == "searching";
    }

    match /ride_history/{historyId} {
      allow create: if signedIn()
        && (
          request.resource.data.passengerId == myUid()
          || request.resource.data.riderId == myUid()
        )
        && request.resource.data.status == "completed"
        && request.resource.data.rideType in ["ride_now", "tomorrow"];

      allow read: if signedIn()
        && (
          resource.data.passengerId == myUid()
          || resource.data.riderId == myUid()
        );

      allow update: if false;
      allow delete: if false;
    }

    // ---------- XP ledger ----------
    // XP is a ledger, not a counter, and that is the entire security
    // model. Rules cannot bind a counter increment to the event that
    // justified it: a rule permissive enough to let a client add 10 to its
    // own xp is permissive enough to let it add 10 a thousand times, and
    // there is no way to say "only alongside a matching event". So there
    // is no counter. A user's XP is the sum of their rows here, and a row
    // only exists if this file agreed to create it.
    //
    // Three independent things have to hold, and none of them are the
    // client's to decide:
    //   1. the document ID is derived from the achievement, so one
    //      achievement can only ever produce one row - a replay is a
    //      create against an existing ID, which Firestore refuses. This is
    //      also what caps the economy: a Tomorrow trip's ID carries the
    //      travel date and direction, so no volume of fabricated requests
    //      can earn more than the two legs a real commuter makes in a day.
    //   2. the amount must equal the canonical value for the reason and
    //      role. Clients cannot price their own rewards.
    //   3. sourceId must point at a real document that proves the claim,
    //      in a state the claimer could not have reached alone - a trip
    //      only reaches "completed" when the other party confirms it.
    //
    // Mirrored by XpRules in the app. This file is the authority.
    match /xp_events/{eventId} {

      function evUser()   { return request.resource.data.userId; }
      function evReason() { return request.resource.data.reason; }
      function evRole()   { return request.resource.data.role; }
      function evSource() { return request.resource.data.sourceId; }
      function evAmount() { return request.resource.data.amount; }
      function evIsRider() { return evRole() == "rider"; }

      // Completing a trip is the only thing worth real XP, and the rider
      // earns more for doing the driving. Note what is absent: accepting a
      // passenger, which used to pay the rider 10 XP on the spot and could
      // be farmed forever by two accounts (accept, cancel, resubmit,
      // accept) without a wheel turning. Nothing pays before a trip ends.
      function amountIsCanonical() {
        return (evReason() == "plan_saved" && evAmount() == 2)
          || (evReason() == "tomorrow_trip_completed" && evIsRider() && evAmount() == 12)
          || (evReason() == "tomorrow_trip_completed" && !evIsRider() && evAmount() == 8)
          || (evReason() == "ride_now_trip_completed" && evIsRider() && evAmount() == 12)
          || (evReason() == "ride_now_trip_completed" && !evIsRider() && evAmount() == 8);
      }

      function idMatches(dedupeKey) {
        return eventId == evUser() + "__" + evReason() + "__" + dedupeKey;
      }

      // NOTE ON SHAPE: every one of these checks its reason BEFORE it
      // reads anything, and each does exactly one get(). That is not
      // stylistic. allow create ORs the three together, so a
      // tomorrow_trip_completed row would otherwise still run the
      // plan_saved branch's get() first - against /rides/{a ride_requests
      // id}, which does not exist. get() on a missing document yields
      // null, reading .data off null is an evaluation error, and an error
      // denies the whole write rather than falling through to the next
      // branch. Guarding on reason first means only the matching branch
      // ever touches the database.

      // plan_saved: the claimer must actually have a plan saved for that
      // travel date, and gets one award for it however many times they
      // rewrite it. The old award fired on every newly created leg, and a
      // still-pending plan is deletable - so save, delete, save paid out
      // indefinitely.
      function planSavedRow() {
        return evReason() == "plan_saved"
          && (evIsRider() ? riderPlanEvidence() : passengerPlanEvidence());
      }

      function riderPlanEvidence() {
        let ride = get(/databases/$(database)/documents/rides/$(evSource())).data;
        return ride.riderId == myUid() && idMatches(ride.rideDate);
      }

      function passengerPlanEvidence() {
        let plan = get(/databases/$(database)/documents/ride_requests/$(evSource())).data;
        return plan.userId == myUid() && idMatches(plan.rideDate);
      }

      // tomorrow_trip_completed: a leg that reached "completed", claimed
      // by one of its two actual parties. The ID carries date + direction,
      // so this is structurally capped at two awards per user per day.
      function tomorrowTripRow() {
        return evReason() == "tomorrow_trip_completed" && tomorrowTripEvidence();
      }

      function tomorrowTripEvidence() {
        let leg = get(/databases/$(database)/documents/ride_requests/$(evSource())).data;

        return leg.status == "completed"
          && leg.get('issueReported', false) == false
          && (evIsRider() ? leg.matchedRiderId == myUid() : leg.userId == myUid())
          && idMatches(leg.rideDate + "__" + leg.tripDirection);
      }

      // ride_now_trip_completed: one award per completion day per route.
      //
      // Ride Now has no travel date of its own to key on the way a Tomorrow
      // leg does, and keying on the request id alone left this as the one
      // uncapped hole in the economy - two accounts could cycle go-live,
      // request, accept, start, confirm, complete, confirm in about a
      // minute and repeat it all evening. The day comes from the trip's own
      // completedAt, so it is not the client's to choose.
      function rideNowTripRow() {
        return evReason() == "ride_now_trip_completed" && rideNowTripEvidence();
      }

      function rideNowTripEvidence() {
        let trip = get(/databases/$(database)/documents/ride_now_requests/$(evSource())).data;
        let day = trip.completedAt;
        let dayKey = string(day.year()) + "-" + string(day.month()) + "-" + string(day.day());

        return trip.status == "completed"
          && trip.get('issueReported', false) == false
          && (evIsRider() ? trip.matchedRiderId == myUid() : trip.passengerId == myUid())
          && idMatches(dayKey + "__" + trip.routeKey);
      }

      allow create: if signedIn()
        && evUser() == myUid()
        && evRole() in ["rider", "passenger"]
        && amountIsCanonical()
        && evSource() is string
        && evSource().size() > 0
        && (planSavedRow() || tomorrowTripRow() || rideNowTripRow());

      allow read: if signedIn() && resource.data.userId == myUid();

      // Append-only, forever. A row that could be edited or deleted is a
      // row that could be re-earned.
      allow update: if false;
      allow delete: if false;
    }

    match /ride_ratings/{ratingId} {
      allow create: if signedIn()
        && request.resource.data.ratedBy == myUid()
        && request.resource.data.ratedTo is string
        && request.resource.data.ratedTo.size() > 0
        && request.resource.data.requestId is string
        && request.resource.data.requestId.size() > 0
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5;

      allow read: if signedIn();

      allow update: if false;
      allow delete: if false;
    }

    match /ride_reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reportedBy == myUid()
        && request.resource.data.reportedUserId is string
        && request.resource.data.reportedUserId.size() > 0
        && request.resource.data.requestId is string
        && request.resource.data.requestId.size() > 0
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.status == "pending";

      allow read: if signedIn();

      allow update: if false;
      allow delete: if false;
    }

    // ---------- In-app notifications ----------
    // Written only by the standalone REST server via the Admin SDK
    // (which bypasses these rules entirely) - e.g. when the cancellation
    // endpoint notifies the other party. Clients only ever read their own
    // notifications and mark them as read; they can never create, forge,
    // or delete one.
    match /notifications/{notificationId} {
      allow read: if signedIn()
        && resource.data.userId == myUid();

      allow update: if signedIn()
        && resource.data.userId == myUid()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["read"]);

      allow create: if false;
      allow delete: if false;
    }
  }
}
